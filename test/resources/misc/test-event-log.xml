<?xml version="1.0" encoding="UTF-8"?>
<Procedure xmlns="http://codac.iter.org/sup/oac-tree" version="1.0"
           name="Procedure to generate lots of messages and test GUIs log window"
           xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
           xs:schemaLocation="http://codac.iter.org/sup/oac-tree oac-tree.xsd">
<Repeat maxCount="100">
    <Sequence>
      <Wait timeout="0.5"/>
      <Message text="Hello A"/>
      <Message text="Hello B"/>
      <Message text="Hello C"/>
      <Wait timeout="0.5"/>
      <Output fromVar="monitor" description=""/>
    </Sequence>
  </Repeat>
  <Workspace>
    <Local name="monitor" type="{&quot;type&quot;:&quot;uint64&quot;}" value="42"/>
  </Workspace>
</Procedure>

